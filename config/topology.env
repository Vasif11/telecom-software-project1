# Scenario A - single source of truth for names and addresses.
# Every script sources this file, so changing an address here changes it everywhere.

# Network namespaces (UE, Access Router, Core/Gateway)
UE_NS=ue
ACC_NS=access
CORE_NS=core

# Link 1: UE <-> Access          10.0.1.0/24
UE_IF=eth0            ; UE_IP=10.0.1.10
ACC_UE_IF=acc-ue      ; ACC_UE_IP=10.0.1.1
UE_NET=10.0.1.0/24

# Link 2: Access <-> Core        10.0.2.0/24
ACC_CORE_IF=acc-core  ; ACC_CORE_IP=10.0.2.1
CORE_ACC_IF=core-acc  ; CORE_ACC_IP=10.0.2.2
ACC_NET=10.0.2.0/24

# Link 3: Core <-> Host (integration boundary to the Data Network)   10.0.3.0/24
CORE_DN_IF=core-dn    ; CORE_DN_IP=10.0.3.1
HOST_DN_IF=host-dn    ; HOST_DN_IP=10.0.3.2
CORE_NET=10.0.3.0/24

# Docker user-defined bridge = containerized Data Network   10.0.4.0/24
DN_BRIDGE=br-dn
DN_NET=10.0.4.0/24
DN_GW=10.0.4.1
NGINX_IP=10.0.4.10 ; NGINX_PORT=80
IPERF_IP=10.0.4.20 ; IPERF_PORT=5201
NGINX_CTR=scenario-a-nginx
IPERF_CTR=scenario-a-iperf3
